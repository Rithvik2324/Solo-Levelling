# Server-only MongoDB Atlas settings. Never commit real credentials.
MONGODB_URI=
MONGODB_DB=AWAKENING

# Google OAuth. Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ALLOWED_GOOGLE_EMAIL=

# Optional progression configuration
XP_PER_LEVEL=1000

# Optional disposable MongoDB database used only by integration tests
MONGODB_TEST_URI=
